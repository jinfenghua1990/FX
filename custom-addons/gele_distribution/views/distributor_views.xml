<odoo>
    <record id="view_gele_distributor_list" model="ir.ui.view">
        <field name="name">gele.distributor.list</field>
        <field name="model">gele.distributor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="contact_name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="order_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_gele_distributor_form" model="ir.ui.view">
        <field name="name">gele.distributor.form</field>
        <field name="model">gele.distributor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="contact_name"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gele_order_list" model="ir.ui.view">
        <field name="name">gele.distributor.order.list</field>
        <field name="model">gele.distributor.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="distributor_id"/>
                <field name="date_order"/>
                <field name="state"/>
                <field name="amount_total"/>
                <field name="wdt_tid"/>
            </list>
        </field>
    </record>

    <record id="view_gele_order_form" model="ir.ui.view">
        <field name="name">gele.distributor.order.form</field>
        <field name="model">gele.distributor.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,pushed"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="distributor_id"/>
                        <field name="date_order"/>
                        <field name="wdt_tid"/>
                        <field name="currency_id"/>
                    </group>
                    <notebook>
                        <page string="Order Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal" readonly="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_total"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gele_distributor" model="ir.actions.act_window">
        <field name="name">Distributors</field>
        <field name="res_model">gele.distributor</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_gele_distributor_order" model="ir.actions.act_window">
        <field name="name">Distributor Orders</field>
        <field name="res_model">gele.distributor.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_gele_root" name="Gele Distribution" sequence="30"/>
    <menuitem id="menu_gele_distributors" name="Distributors" parent="menu_gele_root" action="action_gele_distributor" sequence="10"/>
    <menuitem id="menu_gele_orders" name="Distributor Orders" parent="menu_gele_root" action="action_gele_distributor_order" sequence="20"/>
</odoo>

